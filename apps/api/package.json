{
  "name": "@spout/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "place-order": "tsx scripts/place-order.ts",
    "replay-event": "tsx scripts/replay-event.ts",
    "reconcile": "cross-env ROLE=reconciler RECONCILE_ONCE=1 node -r ts-node/register/transpile-only src/main.ts",
    "alpaca-account": "tsx scripts/alpaca-account.ts",
    "scenario": "tsx scripts/scenario.ts",
    "concurrency": "tsx scripts/concurrency.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@solana/web3.js": "^1.98.4",
    "@spout/shared": "workspace:*",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.24",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/bn.js": "^5.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.15.4",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}