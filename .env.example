# ---- Postgres ----
DATABASE_URL=postgres://spout:spout@localhost:5432/spout

# ---- Solana devnet ----
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com
# Optional failover endpoints for HTTP calls (comma separated), e.g. a Helius/QuickNode devnet URL
RPC_URLS=
# Minimum gap between RPC requests per process (public devnet tolerates ~8 rps)
RPC_MIN_INTERVAL_MS=100
PROGRAM_ID=DB2h5equ9Qp2qaaeKyL9sL6RD8LAhZzjiSUYgnaW3aeF
# Path to the devnet keypair used both to place orders and to settle them
KEYPAIR_PATH=./keys/devnet-keypair.json

# ---- Broker selection: mock | alpaca ----
BROKER=mock
MOCK_BROKER_URL=http://localhost:4010
MOCK_BROKER_PORT=4010
# Initial fault injection for the mock (none | http500 | slow | market_closed | flaky); also settable at runtime
MOCK_FAULT_MODE=none
MOCK_FAIL_RATE=0.5
MOCK_SLOW_MIN_MS=2000
MOCK_SLOW_MAX_MS=10000
MOCK_FILL_DELAY_MS=3000
# Seed of the mock's random failures, so a flaky run is reproducible
MOCK_SEED=42

# ---- Alpaca Broker API sandbox (never commit real values) ----
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_AUTH_URL=https://authx.sandbox.alpaca.markets/v1/oauth2/token
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
ALPACA_ACCOUNT_ID=
# The pipeline refuses any non-sandbox Alpaca host unless this is set
ALPACA_ALLOW_LIVE=0

# ---- Processes ----
ROLE=api
PORT=4000
WORKER_ID=
WORKER_POLL_MS=1000
LEASE_SECONDS=60
RETRY_MAX_ATTEMPTS=10
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000
RECONCILE_INTERVAL_MS=60000
RECONCILE_MIN_AGE_MS=120000

# ---- Safety rails ----
# Orders above this notional (USDC) are never traded automatically: they land in needs_human
MAX_ORDER_USDC=10000
# Circuit breaker: this many critical alerts within the window pause every worker (0 disables)
CIRCUIT_BREAKER_ALERTS=3
CIRCUIT_BREAKER_WINDOW_MS=600000
# When set, ops and chaos endpoints require the header x-admin-token (empty = open, local dev)
ADMIN_TOKEN=

# ---- Chaos hooks (scenarios B and D) ----
# after_broker_accept -> process exits right after the broker accepted, before the DB write
# after_settle_sign   -> process exits after persisting the settlement signature, before the send
WORKER_CRASH_POINT=
# drop_confirmation -> settlement tx is sent but the confirmation is reported as a timeout
CHAIN_FAULT=

LOG_LEVEL=info

# ---- Web console ----
NEXT_PUBLIC_API_URL=http://localhost:4000
# Liveness endpoint for headless roles (listener/worker/reconciler); 0 = off
HEALTH_PORT=0
